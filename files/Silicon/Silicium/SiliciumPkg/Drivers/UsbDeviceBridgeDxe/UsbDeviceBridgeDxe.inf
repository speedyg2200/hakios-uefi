## @file
#  Qualcomm's EFI_USB_DEVICE_PROTOCOL (what HakiOS's xnuloader uses for fastboot) over EFI_USBFN_IO_PROTOCOL,
#  for SoCs whose USB device driver is not Qualcomm's (Samsung Exynos: SamsungPkg UsbfnDwc3Dxe).
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UsbDeviceBridgeDxe
  FILE_GUID                      = F06D2B50-D001-41CD-81C0-6AA62484FE39
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UsbDeviceBridgeDxeInitialize

[Sources]
  UsbDeviceBridgeDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiUsbFunctionIoProtocolGuid                 ## CONSUMES

[Depex]
  gEfiUsbFunctionIoProtocolGuid
